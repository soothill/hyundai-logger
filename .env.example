# Copy this file to .env and fill in your credentials

# Hyundai Bluelink Account Credentials
# Use the same email/password you use to login to the Hyundai/Kia mobile app
HYUNDAI_USERNAME=your-email@example.com
HYUNDAI_PASSWORD=your-password

# PIN: This is the 4-digit PIN you use in the mobile app to start/lock your car
# You can find or set this in the Hyundai/Kia mobile app under:
#   Settings → Profile → Change PIN
# If you haven't set a PIN yet, you'll need to set one in the app first
HYUNDAI_PIN=1234

# Brand: The vehicle manufacturer
# Options: "hyundai" or "kia"
HYUNDAI_BRAND=hyundai

# Region: The geographical region where your Bluelink account is registered
# Options:
#   "EU"  - Europe (Bluelink)
#   "US"  - United States (myHyundai)
#   "CA"  - Canada (myHyundai)
# Important: Use the region where you created your Bluelink account,
# not necessarily where you currently are
HYUNDAI_REGION=EU

# Database (InfluxDB v2)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=hyundai
INFLUXDB_BUCKET=vehicle_data

# Rate limiting
POLL_INTERVAL_MINUTES=5
REQUESTS_PER_HOUR=12
